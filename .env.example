# Endpoint que recebe o POST do formulário "Solicite um orçamento".
# Vazio => usa a rota local /api/orcamento (stub que responde 501).
NEXT_PUBLIC_QUOTE_ENDPOINT=

# Domínio de produção, sem barra no final (ex.: https://www.bandejaorefeicoes.com.br).
# Usado em og:url, og:image e <link rel="canonical">.
NEXT_PUBLIC_SITE_URL=
